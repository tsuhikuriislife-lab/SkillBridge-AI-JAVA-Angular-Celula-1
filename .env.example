POSTGRES_DB=skillbridge
POSTGRES_USER=skillbridge
POSTGRES_PASSWORD=skillbridge_dev
# Inyectar exclusivamente mediante secretos del entorno. Minimo 32 caracteres y alta entropia (ej: openssl rand -base64 32)
JWT_SECRET=secret_dev_key_skillbridge_jwt_2026
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:4200
LIVEKIT_API_KEY=devkey
LIVEKIT_RTC_USE_EXTERNAL_IP=false
NODE_IP=127.0.0.1
LIVEKIT_RTC_NODE_IP=127.0.0.1
LIVEKIT_RTC_ENABLE_LOOPBACK_CANDIDATE=true
LIVEKIT_API_SECRET=secret_dev_key_skillbridge_livekit_2026 # openssl rand -hex 32 para generar un secreto seguro
LIVEKIT_HTTP_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
# openssl rand -hex 32
LIVEKIT_REDIS_PASSWORD=change_me_use_openssl_rand_hex_32

# ---------- notifications-service ----------
# log = no envía correos, sólo los escribe en el log (por defecto). resend = envío real.
EMAIL_DRIVER=log
# API key de Resend (https://resend.com/api-keys). Permiso "Sending access". NUNCA la subas a git.
RESEND_API_KEY=
# Secreto de firma del webhook de Resend (empieza por whsec_). Ver CONFIGURACION-DOMINIO-Y-SECRETOS.md §9
RESEND_WEBHOOK_SECRET=
# Remitente de un dominio VERIFICADO. Mientras no lo esté: SkillBridge AI <onboarding@resend.dev>
MAIL_FROM=SkillBridge AI <notificaciones@mail.skillbridgeai.online>
MAIL_REPLY_TO=support@skillbridgeai.online
# Sólo desarrollo: redirige TODOS los correos a esta dirección
MAIL_REDIRECT_TO=
FRONTEND_URL=http://localhost:8088

# HU-PS06 Feature Store (Compose apunta a los servicios redis y rabbitmq)
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
FEATURE_STORE_BATCH_INTERVAL_HOURS=24
FEATURE_STORE_TTL_SECONDS=259200
FEATURE_STORE_BATCH_SIZE=500
FEATURE_STORE_BATCH_PAUSE_MS=50
EMBEDDING_DIMENSION=384
